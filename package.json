{
  "name": "crypto-hardware-command-inspector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @chci/explorer dev",
    "build": "pnpm --filter @chci/parser-core build && pnpm --filter @chci/device-specs build && pnpm --filter @chci/explorer build",
    "build:web": "VITE_TARGET=web pnpm build",
    "build:installer": "pnpm build && pnpm dlx @tauri-apps/cli build --bundles nsis",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint packages apps e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitejs/plugin-react": "^5.0.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.2.7",
    "vitest": "4.1.11",
    "zod": "^4.1.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
